---
/**
 * Accueil d'une langue (RECETTE §5), ordre propre à ce site : la couleur du jour et de demain
 * d'abord (c'est la question), puis le comparateur Base / Heures creuses / Tempo, puis le bloc
 * citable replié et le texte. Texte dans src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import ColourToday from './tempo/ColourToday';
import CompareCalc from './tempo/CompareCalc';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { AUTHOR_NAME } from '../data/site-config';
import { BUILD_TODAY, BUILD_HOUR } from '../lib/today';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['spTrve2026', 'spFournisseur', 'rteCalendrier', 'rteMethode', 'creTempo2014', 'cre2026189', 'grilleEdf', 'creTrve2026', 'creHc2026', 'enedisHc', 'eco2mix'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const fr = lang === 'fr';
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <ColourToday client:load lang={lang} buildDate={BUILD_TODAY} buildHour={BUILD_HOUR} />
  <p class="mb-2 mt-4 font-serif text-lg font-semibold text-navy-900">{x.calcTitle}</p>
  <div data-outil><CompareCalc client:load lang={lang} methodHref={route('method', lang)} id="accueil" /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-2" />
  <p class="mt-3 text-sm text-navy-600">{fr ? 'Par' : 'By'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{fr ? 'Méthode de calcul' : 'Calculation method'}</a> · <a href={route('comparateur', lang)} class="underline">{fr ? 'Comparateur détaillé' : 'Detailed comparison'}</a></p>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={route('comparateur', lang)} />)}
  </div>
</PageLayout>
